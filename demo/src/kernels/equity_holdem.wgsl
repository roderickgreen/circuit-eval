fn cmp24(a: ptr<function, array<word, 24>>,
    b: ptr<function, array<word, 24>>) -> array<word, 2> {
  var gt = ZERO;
  var eq = ONES;
  for (var i = 0u; i < 24u; i++) {
    let k = 23u - i;
    gt |= eq & (*a)[k] & ~(*b)[k];
    eq &= ~((*a)[k] ^ (*b)[k]);
  }
  return array<word, 2>(gt, eq);
}

